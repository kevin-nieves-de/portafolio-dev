# Proveedor de modelo de lenguaje: "anthropic" o "gemini" (ambos tienen adaptador).
LLM_PROVIDER=anthropic

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
# Clave del proveedor. NUNCA se commitea, nunca aparece en el front ni en los logs.
ANTHROPIC_API_KEY=
# Modelo a usar por el adaptador.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Gemini (si LLM_PROVIDER=gemini) ---
# Clave de Google AI Studio. Mismas reglas: nunca se commitea ni se expone.
GEMINI_API_KEY=
# Modelo a usar. Si se cambia a gemini-2.5-pro hay que ajustar thinkingBudget en src/llm/gemini.ts (mínimo 128).
GEMINI_MODEL=gemini-2.5-flash

# Puerto del backend HTTP.
PORT=3002

# Tope de iteraciones herramienta<->modelo por turno (CA1).
AGENT_MAX_ITERATIONS=25

# Tope de tokens acumulados por sesión (entrada + salida de todas las llamadas), para que un
# usuario no agote la clave sin límite. Procesar el buzón completo consume ~400k en un turno.
AGENT_MAX_TOKENS_PER_SESSION=1000000

# Tope global de tokens de todo el proceso: evita esquivar el tope por sesión abriendo sesiones nuevas.
AGENT_MAX_TOKENS_TOTAL=10000000

# Máximo de sesiones en memoria; al llegar al tope se descarta la más antigua.
AGENT_MAX_SESSIONS=100

# Tope en milisegundos de cada llamada al modelo (no del turno completo).
AGENT_LLM_TIMEOUT_MS=120000

# true = cada sesión del chat trabaja en out/sesiones/<id>/ con su propio maestro y log (recomendado
# en un link público). Vacío o false = todas comparten out/, con las rutas exactas del PRD.
AGENT_SESIONES_AISLADAS=

# Si se define, protege /api/* exigiendo el header "x-access-key". Déjala vacía para link público.
ACCESS_KEY=
