{
  "name": "reto-02-agente-registro-contratos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional que registra contratos vigentes desde un buzón único, detecta duplicados y actualizaciones, y alerta vencimientos",
  "scripts": {
    "demo": "tsx demo.ts",
    "server": "tsx src/server.ts",
    "server:dev": "tsx watch src/server.ts",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "dev": "concurrently -n server,web -c blue,green \"npm:server:dev\" \"npm:web:dev\"",
    "build": "npm install --prefix web && npm run web:build",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "sync:modulo": "tsx scripts/sync-modulo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "tsx": "^4.19.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
